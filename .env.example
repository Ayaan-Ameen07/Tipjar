# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# A Sepolia RPC endpoint. No signup needed if you use the public one below,
# or paste your own Alchemy/Infura Sepolia URL for more reliability.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Free API key from https://etherscan.io/myapikey — used only for source verification.
ETHERSCAN_API_KEY=

# NOTE: your deploying wallet's private key is intentionally NOT stored here.
# We use Foundry's encrypted keystore instead (see README) so it never sits
# in a plaintext file or gets pasted into chat.
